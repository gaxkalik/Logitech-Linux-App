[Unit]
Description=Logitech G502 Custom Macro Daemon
After=graphical-session.target sound.target
Wants=ratbagd.service

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/bart/.gemini/antigravity/scratch/g502_macros/g502_macro_daemon.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
